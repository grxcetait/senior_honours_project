@article{mazumderHiIntensityMapping2025,
  title = {Hi Intensity Mapping with the {{MIGHTEE Survey}}: First Results of the {{Hi}} Power Spectrum},
  shorttitle = {Hi Intensity Mapping with the {{MIGHTEE Survey}}},
  author = {Mazumder, Aishrila and Wolz, Laura and Chen, Zhaoting and Paul, Sourabh and Santos, Mario G and Jarvis, Matt and Townsend, Junaid and Sekhar, Srikrishna and Taylor, Russ},
  year = 2025,
  month = jul,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {541},
  number = {1},
  pages = {476--493},
  issn = {0035-8711},
  doi = {10.1093/mnras/staf975},
  urldate = {2026-02-27},
  abstract = {We present the first results of the H\,i intensity mapping power spectrum analysis with the MeerKAT International GigaHertz Tiered Extragalactic Exploration (MIGHTEE) survey. We use data covering \$\textbackslash sim\$ 4 square degrees in the COSMOS field using a frequency range of 962.5--1008.42\,MHz, equivalent to H\,i emission in \$0.4\&lt; z\&lt; 0.48\$. The data consist of 15 pointings with a total of 94.2~h on-source. We verify the suitability of the MIGHTEE data for H\,i intensity mapping by testing for residual systematics across frequency, baselines, and pointings. We also vary the window used for H\,i signal measurements and find no significant improvement using stringent Fourier mode cuts. We compute the H\,i power spectrum at scales \$0.5\textbackslash, \textbackslash textrm \textbraceleft Mpc\textbraceright\textasciicircum\textbraceleft -1\textbraceright{} \textbackslash lesssim k \textbackslash lesssim 10\textbackslash, \textbackslash textrm \textbraceleft Mpc\textbraceright\textasciicircum\textbraceleft -1\textbraceright\$ in autocorrelation as well as cross-correlation between observational scans using power spectrum domain averaging for pointings. We report consistent upper limits of 29.8 \,mK\$\textasciicircum\textbraceleft 2\textbraceright\$ Mpc\$\textbraceleft\textasciicircum 3\textbraceright\$ from the 2\$\textbackslash sigma\$ cross-correlation measurements and 25.82\,mK\$\textasciicircum\textbraceleft 2\textbraceright\$ Mpc\$\textbraceleft\textasciicircum 3\textbraceright\$ from autocorrelation at \$k\textbackslash sim\$2\,Mpc\$\textasciicircum\textbraceleft -1\textbraceright\$.The low signal-to-noise ratio in this data potentially limits our ability to identify residual systematics, which will be addressed in the future by incorporating more data in the analysis.},
  file = {/Users/gracetait/Zotero/storage/D37MBUBR/Mazumder et al. - 2025 - Hi intensity mapping with the MIGHTEE Survey first results of the Hi power spectrum.pdf;/Users/gracetait/Zotero/storage/8U3VHISD/staf975.html}
}

