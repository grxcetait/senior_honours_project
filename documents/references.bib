@online{peterson21CmIntensity2009,
  title = {21 Cm {{Intensity Mapping}}},
  author = {Peterson, Jeffrey B. and Aleksan, Roy and Ansari, Reza and Bandura, Kevin and Bond, Dick and Bunton, John and Carlson, Kermit and Chang, Tzu-Ching and DeJongh, Fritz and Dobbs, Matt and Dodelson, Scott and Darhmaoui, Hassane and Gnedin, Nick and Halpern, Mark and Hogan, Craig and Goff, Jean-Marc Le and Liu, Tiehui Ted and Legrouri, Ahmed and Loeb, Avi and Loudiyi, Khalid and Magneville, Christophe and Marriner, John and McGinnis, David P. and McWilliams, Bruce and Moniez, Marc and Palanque-Delabruille, Nathalie and Pasquinelli, Ralph J. and Pen, Ue-Li and Rich, Jim and Scarpine, Vic and Seo, Hee-Jong and Sigurdson, Kris and Seljak, Uros and Stebbins, Albert and Steffen, Jason H. and Stoughton, Chris and Timbie, Peter T. and Vallinotto, Alberto and Wyithe, Stuart and Yeche, Christophe},
  date = {2009-02-18},
  eprint = {0902.3091},
  eprinttype = {arXiv},
  eprintclass = {astro-ph},
  doi = {10.48550/arXiv.0902.3091},
  url = {http://arxiv.org/abs/0902.3091},
  urldate = {2026-02-27},
  abstract = {Using the 21 cm line, observed all-sky and across the redshift range from 0 to 5, the large scale structure of the Universe can be mapped in three dimensions. This can be accomplished by studying specific intensity with resolution \textasciitilde{} 10 Mpc, rather than via the usual galaxy redshift survey. The data set can be analyzed to determine Baryon Acoustic Oscillation wavelengths, in order to address the question: 'What is the nature of Dark Energy?' In addition, the study of Large Scale Structure across this range addresses the questions: 'How does Gravity effect very large objects?' and 'What is the composition our Universe?' The same data set can be used to search for and catalog time variable and transient radio sources.},
  pubstate = {prepublished},
  keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics,Astrophysics - Instrumentation and Methods for Astrophysics},
  file = {/Users/gracetait/Zotero/storage/VL2Z7B72/Peterson et al. - 2009 - 21 cm Intensity Mapping.pdf;/Users/gracetait/Zotero/storage/S8IDWVEL/0902.html}
}

