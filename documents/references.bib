@article{hothiComparingForegroundRemoval2021,
  title = {Comparing Foreground Removal Techniques for Recovery of the {{LOFAR-EoR}} 21\,Cm Power Spectrum},
  author = {Hothi, Ian and Chapman, Emma and Pritchard, Jonathan R and Mertens, F G and Koopmans, L V E and Ciardi, B and Gehlot, B K and Ghara, R and Ghosh, A and Giri, S K and Iliev, I T and Jelić, V and Zaroubi, S},
  date = {2021-01-11},
  journaltitle = {Monthly Notices of the Royal Astronomical Society},
  shortjournal = {Mon Not R Astron Soc},
  volume = {500},
  number = {2},
  pages = {2264--2277},
  issn = {0035-8711},
  doi = {10.1093/mnras/staa3446},
  url = {https://doi.org/10.1093/mnras/staa3446},
  urldate = {2026-03-18},
  abstract = {We compare various foreground removal techniques that are being utilized to remove bright foregrounds in various experiments aiming to detect the redshifted 21\,cm signal of neutral hydrogen from the epoch of reionization. In this work, we test the performance of removal techniques (FastICA, GMCA, and GPR) on 10 nights of LOFAR data and investigate the possibility of recovering the latest upper limit on the 21\,cm signal. Interestingly, we find that GMCA and FastICA reproduce the most recent 2σ upper limit of \$\textbackslash Delta \textasciicircum 2\_\{21\} \textbackslash lt \$ (73)2 mK2 at k~= 0.075\,hcMpc−1, which resulted from the application of GPR. We also find that FastICA and GMCA begin to deviate from the noise-limit at k-scales larger than ∼0.1\,hcMpc−1. We then replicate the data via simulations to see the source of FastICA and GMCA’s limitations, by testing them against various instrumental effects. We find that no single instrumental effect, such as primary beam effects or mode-mixing, can explain the poorer recovery by FastICA and GMCA at larger k-scales. We then test scale-independence of FastICA and GMCA, and find that lower k-scales can be modelled by a smaller number of independent components. For larger scales (k ≳ 0.1\,hcMpc−1), more independent components are needed to fit the foregrounds. We conclude that, the current usage of GPR by the LOFAR collaboration is the appropriate removal technique. It is both robust and less prone to overfitting, with future improvements to GPR’s fitting optimization to yield deeper limits.},
  file = {/Users/gracetait/Zotero/storage/4AT4FANU/Hothi et al. - 2021 - Comparing foreground removal techniques for recovery of the LOFAR-EoR 21 cm power spectrum.pdf;/Users/gracetait/Zotero/storage/R5PVSD4J/staa3446.html}
}

