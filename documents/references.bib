@article{cunningtonHIIntensityMapping2022,
  title = {{{HI}} Intensity Mapping with {{MeerKAT}}: Power Spectrum Detection in Cross-Correlation with {{WiggleZ}} Galaxies},
  shorttitle = {{{HI}} Intensity Mapping with {{MeerKAT}}},
  author = {Cunnington, Steven and Li, Yichao and Santos, Mario G. and Wang, Jingying and Carucci, Isabella P. and Irfan, Melis O. and Pourtsidou, Alkistis and Spinelli, Marta and Wolz, Laura and Soares, Paula S. and Blake, Chris and Bull, Philip and Engelbrecht, Brandon and Fonseca, Jos{\'e} and Grainge, Keith and Ma, Yin-Zhe},
  year = 2022,
  month = dec,
  journal = {Monthly Notices of the Royal Astronomical Society},
  volume = {518},
  number = {4},
  eprint = {2206.01579},
  primaryclass = {astro-ph},
  pages = {6262--6272},
  issn = {0035-8711, 1365-2966},
  doi = {10.1093/mnras/stac3060},
  urldate = {2026-01-20},
  abstract = {We present a detection of correlated clustering between MeerKAT radio intensity maps and galaxies from the WiggleZ Dark Energy Survey. We find a \$7.7{$\sigma\$$} detection of the cross-correlation power spectrum, the amplitude of which is proportional to the product of the HI density fraction (\$\textohm\_\textbraceleft\textbackslash rm HI\textbraceright\$), HI bias (\$b\_\textbraceleft\textbackslash rm HI\textbraceright\$) and the cross-correlation coefficient (\$r\$). We therefore obtain the constraint \$\textohm\_\textbraceleft\textbackslash rm HI\textbraceright{} b\_\textbraceleft\textbackslash rm HI\textbraceright{} r\textbackslash,\textbraceleft =\textbraceright\textbackslash,[0.86\textbackslash,\textbraceleft\textbackslash pm\textbraceright\textbackslash,0.10\textbackslash,(\textbraceleft\textbackslash rm stat\textbraceright )\textbackslash,\textbraceleft\textbackslash pm\textbraceright\textbackslash,0.12\textbackslash,(\textbraceleft\textbackslash rm sys\textbraceright )]\textbackslash,\textbraceleft\textbackslash times\textbraceright\textbackslash,10\textasciicircum\textbraceleft -3\textbraceright\$, at an effective scale of \$k\_\textbraceleft\textbackslash rm eff\textbraceright\textbackslash,\textbraceleft\textbackslash sim\textbraceright\textbackslash,0.13\textbackslash,h\textbackslash,\textbraceleft\textbackslash rm Mpc\textbraceright\textasciicircum\textbraceleft -1\textbraceright\$. The intensity maps were obtained from a pilot survey with the MeerKAT telescope, a 64-dish pathfinder array to the SKA Observatory (SKAO). The data were collected from 10.5 hours of observations using MeerKAT's L-band receivers over six nights covering the 11hr field of WiggleZ, in the frequency range \$1015-973\textbackslash,\textbraceleft\textbackslash rm MHz\textbraceright\$ (0.400\$\textbackslash,\textbraceleft{$<$}\textbraceright\textbackslash,z\textbackslash,\textbraceleft{$<$}\textbraceright\textbackslash,\$0.459 in redshift). This detection is the first practical demonstration of the multi-dish auto-correlation intensity mapping technique for cosmology. This marks an important milestone in the roadmap for the cosmology science case with the full SKAO.},
  archiveprefix = {arXiv},
  keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics},
  file = {/Users/gracetait/Zotero/storage/CTV7ADBT/Cunnington et al. - 2022 - HI intensity mapping with MeerKAT power spectrum detection in cross-correlation with WiggleZ galaxi.pdf;/Users/gracetait/Zotero/storage/ZA764LRG/2206.html}
}

